generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  TEKNISI
}

enum OpticStatus {
  LINKUP
  LINKDOWN
}

enum OnuStatus {
  UNVERIFIED
  ACTIVE
  SUSPEND
  REPLACED
}

enum ConnectionState {
  ONLINE
  OFFLINE
  ONU_POWER_OFF
  FIBER_LOS
  ONU_AUTH_FAILED
  UNKNOWN
}

enum EndpointType {
  CUSTOMER
  RESELLER
  POP
  BACKHAUL
}

enum AlarmType {
  ONU_LINKUP
  ONU_LINKDOWN
  ONU_UNREGISTERED
  ONU_LOS
  ONU_DYING_GASP
}

enum TelegramRole {
  ADMIN
  TEKNISI
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  role      Role     @default(TEKNISI)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Olt {
  id               String            @id @default(cuid())
  name             String            @unique
  syslogName       String            @unique
  ipAddress        String            @unique
  telnetPort       Int               @default(23)
  username         String
  password         String
  vendor           String
  location         String?
  onus             Onu[]
  alarmLogs        AlarmLog[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  unauthorizedOnus UnauthorizedOnu[]
}

model Onu {
  id               String           @id @default(cuid())
  oltId            String
  olt              Olt              @relation(fields: [oltId], references: [id], onDelete: Cascade)
  endpointId       String?
  endpoint         Endpoint?        @relation(fields: [endpointId], references: [id])
  packageId        String?
  package          Package?         @relation(fields: [packageId], references: [id])
  onuId            String
  eponPort         String
  onuMac           String           @unique
  onuName          String?
  onuComtName      String?
  onuType          String?
  model            String?
  firmware         String?
  status           OnuStatus?
  connectionState  ConnectionState?
  temperature      String?
  voltage          String?
  txBias           String?
  txPower          String?
  rxPower          String?
  isActive         Boolean          @default(true)
  alarmLogs        AlarmLog[]
  events           OnuEvent[]
  replacementsFrom OnuReplacement[] @relation("OldOnuReplacement")
  replacementsTo   OnuReplacement[] @relation("NewOnuReplacement")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([oltId, eponPort, onuId])
  @@index([oltId])
  @@index([endpointId])
  @@index([onuMac])
  @@index([connectionState])
}

model OnuReplacement {
  id         String   @id @default(cuid())
  endpointId String
  oldOnuId   String
  newOnuId   String
  reason     String?
  replacedBy String?
  createdAt  DateTime @default(now())
  endpoint   Endpoint @relation(fields: [endpointId], references: [id])
  oldOnu     Onu      @relation("OldOnuReplacement", fields: [oldOnuId], references: [id])
  newOnu     Onu      @relation("NewOnuReplacement", fields: [newOnuId], references: [id])
}

model Endpoint {
  id           String           @id @default(cuid())
  type         EndpointType
  internetNo   String           @unique
  name         String
  code         String?          @unique
  address      String?
  latitude     Float?
  longitude    Float?
  description  String?
  onus         Onu[]
  replacements OnuReplacement[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model Package {
  id           String   @id @default(cuid())
  name         String
  speed        String
  price        Int
  normalDevice String?
  onus         Onu[]
  createdAt    DateTime @default(now())
}

model UnauthorizedOnu {
  id           String   @id @default(cuid())
  oltId        String
  olt          Olt      @relation(fields: [oltId], references: [id], onDelete: Cascade)
  onuComtName  String?
  onuName      String?
  status       String?
  macAddress   String   @unique
  eponPort     String
  onuId        String
  discoveredAt DateTime @default(now())
  createdAt    DateTime @default(now())
}

model AlarmLog {
  id        String    @id @default(cuid())
  oltId     String
  olt       Olt       @relation(fields: [oltId], references: [id])
  onuIdRef  String?
  onu       Onu?      @relation(fields: [onuIdRef], references: [id])
  type      AlarmType
  message   String    @db.Text
  rawLog    String    @db.Text
  sourceIp  String
  createdAt DateTime  @default(now())

  @@index([type])
  @@index([createdAt])
}

model TelegramLog {
  id        String   @id @default(cuid())
  chatId    String
  command   String
  response  String?  @db.Text
  createdAt DateTime @default(now())
}

model TelegramBot {
  id                 String              @id @default(cuid())
  telegramBotId      String?
  name               String
  username           String?
  token              String
  webhookUrl         String?
  defaultChatId      String?
  description        String?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  users              TelegramUser[]
  telegramAccessLogs TelegramAccessLog[]
}

model TelegramUser {
  id            String       @id @default(cuid())
  telegramId    String       @unique
  username      String?
  fullName      String?
  role          TelegramRole @default(TEKNISI)
  isActive      Boolean      @default(true)
  telegramBotId String?
  bot           TelegramBot? @relation(fields: [telegramBotId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model TelegramAccessLog {
  id            String       @id @default(cuid())
  telegramId    String
  username      String?
  firstName     String?
  message       String?      @db.Text
  chatType      String?
  isAuthorized  Boolean
  telegramBotId String?
  rawUpdate     Json?
  createdAt     DateTime     @default(now())
  bot           TelegramBot? @relation(fields: [telegramBotId], references: [id])
}

model OnuEvent {
  id          String   @id @default(cuid())
  onuId       String
  onu         Onu      @relation(fields: [onuId], references: [id], onDelete: Cascade)
  event       String
  oldState    String?
  newState    String?
  source      String?
  description String?
  createdAt   DateTime @default(now())

  @@index([onuId])
  @@index([event])
  @@index([createdAt])
}
